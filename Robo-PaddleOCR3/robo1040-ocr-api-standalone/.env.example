# Same defaults as team Docker (.env / docker-compose)
API_KEY=robo1040
OCR_LANG=eng
OCR_DPI=200
OCR_MAX_SIDE_PX=2400
MAX_UPLOAD_MB=25
SINGLE_FORM_MAX_PAGES=1
BROKERAGE_MAX_PAGES=3
MAX_PAGES=3
ALLOWED_ORIGINS=*

# Extraction pipeline
# Offline / first install: keep Structure+VL off until models + paddlex[ocr] are ready
USE_DIGITAL_PDF=true
DIGITAL_PDF_MIN_CHARS=200
DIGITAL_PDF_QUALITY_THRESHOLD=0.30
USE_PP_STRUCTURE=false
USE_KIE=true
USE_IMAGE_PREPROCESSING=false
USE_PADDLEOCR_VL=false
USE_SCHEMA_EXTRACT=true

# Optional local LLM (leave empty unless you run Ollama locally)
# SCHEMA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SCHEMA_LLM_MODEL=qwen2.5:7b
# SCHEMA_LLM_TIMEOUT_S=45

# Label memory (included in this package)
LABEL_MEMORY_PATH=training/learned_patterns.json
